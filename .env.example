# Copy to .env and adjust. Every value here has a working default in
# internal/config, so an empty .env still boots in development.

APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warn | error

# --- HTTP -------------------------------------------------------------------
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s

# --- Postgres ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders?sslmode=disable

# Pool sizing is the single most load-bearing number under concurrency.
# A 4-core Postgres saturates at roughly 8-16 connections TOTAL; beyond that,
# extra connections contend for the same cores and throughput DROPS.
# This is per process, so N api replicas multiply it — that product must stay
# under Postgres max_connections (default 100), or use PgBouncer.
DB_MAX_OPEN_CONNS=12
DB_MAX_IDLE_CONNS=12
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=orders
# Prefetch bounds unacked deliveries per consumer. Without it one consumer
# grabs the whole queue and its competing consumers sit idle.
RABBITMQ_PREFETCH=16

# --- Redis (rate limiting only) ---------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth -------------------------------------------------------------------
# REQUIRED in production; the service refuses to boot without it. In development
# it falls back to a known insecure value.
JWT_SECRET=
JWT_TTL=24h
BCRYPT_COST=12               # lower to 4 in tests; 12 is deliberately slow
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# --- Order pipeline ---------------------------------------------------------
# How long stock stays held for an unpaid order before the reaper reclaims it.
# Too short and slow payments fail; too long and abandoned carts starve buyers.
RESERVATION_TTL=15m
MAX_ITEMS_PER_ORDER=50
DEADLOCK_RETRIES=3

# --- Workers ----------------------------------------------------------------
WORKER_CONCURRENCY=10
REAPER_INTERVAL=30s
RELAY_INTERVAL=500ms
RELAY_BATCH_SIZE=100
NOTIFY_LEASE_TTL=60s
# Backoff between retries of a notification whose send failed, not just a poll
# rate: the broker delivery is already acked by then, so this loop is the only
# thing that will ever try again.
NOTIFY_RETRY_INTERVAL=30s
# Must exceed the longest in-flight job, or a rolling deploy SIGKILLs a worker
# mid-payment.
WORKER_SHUTDOWN_TIMEOUT=30s

# --- Payments ---------------------------------------------------------------
PAYMENT_PROVIDER=simulated
# The simulated provider must be able to produce all three outcomes, including
# UNKNOWN — a provider that always succeeds exercises none of the hard paths.
PAYMENT_FAILURE_RATE=0.10
PAYMENT_TIMEOUT_RATE=0.02
PAYMENT_LATENCY=200ms
PAYMENT_TIMEOUT=5s

# --- Observability (README.md:257-258 bonus) --------------------------------
# OTLP collector for traces, host:port. EMPTY DISABLES EXPORT, which is the
# default: `go test` and `go run` must not require a running Jaeger. Trace ids
# are still generated and still propagate through the outbox and the broker
# either way — they are simply not shipped anywhere.
# docker compose sets this to jaeger:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Each entry point appends its own suffix, so the trace waterfall reads
# order-processing-api -> order-processing-relay -> order-processing-worker.
OTEL_SERVICE_NAME=order-processing
# Metrics listener for the worker and relay, which have no HTTP server of their
# own. The api serves /metrics on HTTP_PORT instead and ignores this.
METRICS_ADDR=:9100
