# Non-secret configuration, shared by api, worker and relay.
#
# Mirrors .env.example, minus four values that carry credentials and therefore
# live in the `app-secrets` Secret instead: DATABASE_URL, RABBITMQ_URL,
# JWT_SECRET, REDIS_PASSWORD.
#
# Also missing: DB_MAX_OPEN_CONNS and DB_MAX_IDLE_CONNS. Those are set per
# workload, because the connection budget is divided between the three
# deployments rather than shared — see the arithmetic in api-deployment.yaml.
#
# Consumed by configMapGenerator, so editing this file changes the ConfigMap's
# content hash and rolls the pods. A hand-written ConfigMap would be edited in
# place and nothing would restart to notice.

# The base is production-shaped: you opt into development, not out of it.
# overlays/dev patches this back to `development`, which is also what re-enables
# the Swagger UI.
APP_ENV=production
LOG_LEVEL=info

# --- HTTP -------------------------------------------------------------------
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
# Bounds the drain on SIGTERM. terminationGracePeriodSeconds must exceed this
# plus the preStop sleep, or the kubelet SIGKILLs the pod mid-drain.
HTTP_SHUTDOWN_TIMEOUT=20s

# --- Postgres ---------------------------------------------------------------
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_EXCHANGE=orders
RABBITMQ_PREFETCH=16

# --- Redis (rate limiting only) ---------------------------------------------
REDIS_ADDR=redis:6379
REDIS_DB=0

# --- Auth -------------------------------------------------------------------
JWT_TTL=24h
BCRYPT_COST=12

# Per-identity, enforced in Redis, so the limit is the same number no matter how
# many API replicas the HPA has created. An in-process limiter would silently
# become `replicas × RATE_LIMIT_RPS`.
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# --- Order pipeline ---------------------------------------------------------
RESERVATION_TTL=15m
MAX_ITEMS_PER_ORDER=50
DEADLOCK_RETRIES=3

# --- Workers ----------------------------------------------------------------
WORKER_CONCURRENCY=10
REAPER_INTERVAL=30s
RELAY_INTERVAL=500ms
RELAY_BATCH_SIZE=100
NOTIFY_LEASE_TTL=60s
WORKER_SHUTDOWN_TIMEOUT=30s

# --- Payments ---------------------------------------------------------------
# `simulated` is the only provider implemented. The failure and timeout rates
# are zero here because a base overlay describes a real deployment; overlays/dev
# turns them back up so declines, timeouts and the UNKNOWN path are all
# reachable in a demo.
PAYMENT_PROVIDER=simulated
PAYMENT_FAILURE_RATE=0
PAYMENT_TIMEOUT_RATE=0
PAYMENT_LATENCY=200ms
PAYMENT_TIMEOUT=5s

# --- Migrations -------------------------------------------------------------
# Where cmd/migrate reads the SQL from inside the image (docker/Dockerfile:38).
MIGRATIONS_DIR=/app/migrations
